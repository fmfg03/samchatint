                    "properties": {
                      "slot": {
                        "const": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "role": {
                        "const": "director_tecnico"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "slot": {
                        "const": 2
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "role": {
                        "const": "auxiliar"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "presence": {
                        "const": "ABSENT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "field_decision_hashes": {
                        "maxItems": 0
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "field_decision_hashes": {
                        "minItems": 1
