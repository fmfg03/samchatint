          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "player_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35
        },
        "player_entry_binding": {
          "type": "string",
          "pattern": "^hmac-sha256:[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACTIVATE_PLAYER"
              }
            }
          },
          "then": {
            "properties": {
              "cas_succeeded": {
                "const": true
              },
              "blocking_incident_count": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
