          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "event_type": {
          "const": "samchat_registration_roster_decision_v2"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ordered_player_slots": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 35
          },
          "uniqueItems": true
        },
        "ordered_player_field_decision_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "ordered_staff_slots": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "role",
                "staff_entry_binding",
                "presence",
                "source_page_hash",
                "evidence_binding",
                "review_decision_hash",
                "field_decision_hashes"
              ],
              "properties": {
                "slot": {
                  "type": "integer",
                  "enum": [
                    1,
                    2
                  ]
                },
                "role": {
                  "enum": [
                    "director_tecnico",
                    "auxiliar"
                  ]
                },
                "staff_entry_binding": {
                  "type": "string",
                  "pattern": "^hmac-sha256:[a-f0-9]{64}$"
                },
                "presence": {
                  "enum": [
                    "PRESENT",
                    "ABSENT"
                  ]
                },
                "source_page_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "evidence_binding": {
                  "type": "string",
                  "pattern": "^hmac-sha256:[a-f0-9]{64}$"
                },
                "review_decision_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "field_decision_hashes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "slot": {
                        "const": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "role": {
                        "const": "director_tecnico"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "slot": {
                        "const": 2
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "role": {
                        "const": "auxiliar"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "presence": {
                        "const": "ABSENT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "field_decision_hashes": {
                        "maxItems": 0
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "field_decision_hashes": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "role",
                "staff_entry_binding",
                "presence",
                "source_page_hash",
                "evidence_binding",
                "review_decision_hash",
                "field_decision_hashes"
              ],
              "properties": {
                "slot": {
                  "type": "integer",
