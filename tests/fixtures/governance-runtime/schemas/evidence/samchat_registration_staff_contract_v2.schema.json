        "workflow_id": {
          "const": "samchat_registration_identity_v2"
        },
        "effective_sal": {
          "const": "SAL-3"
        },
        "policy_id": {
          "const": "samchat_registration_identity_policy_v2"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
