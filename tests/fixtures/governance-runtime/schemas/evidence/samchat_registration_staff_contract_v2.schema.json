          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source_page_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1
        },
        "incident_state_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "roster_draft_binding": {
          "type": "string",
          "pattern": "^hmac-sha256:[a-f0-9]{64}$"
        },
        "decision": {
          "enum": [
            "AUTHORIZE_PENDING_MATERIALIZATION",
            "REQUIRE_ROSTER_REVIEW",
            "DENY_ROSTER_MATERIALIZATION"
          ]
