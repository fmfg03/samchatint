{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isolated Batise\u00f1al pilot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "agent_kind",
    "approval_ref",
    "attestation_sha256",
    "audit_path",
    "case_id",
    "client_id",
    "cookie_name",
    "cookie_ref",
    "database",
    "enabled",
    "evidence_path",
    "installation_id",
    "key_id",
    "migration_hashes",
    "organization",
    "origin",
    "owner_ref",
    "owner_role",
    "policy_sha256",
    "port",
    "project",
    "protocol",
    "public_key_sha256",
    "redirect_uri",
    "registration_sha256",
    "release",
    "report_id",
    "retention_ref",
    "runtime_role",
    "schema",
    "signer_ref",
    "socket_directory",
    "tournament_id",
    "tree",
    "verifier_ref",
    "version"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_kind": {
      "enum": [
        "synthetic_stub",
        "ai_agent"
      ]
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audit_path": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "cookie_name": {
      "type": "string",
      "pattern": "^batisenal_[a-z0-9_]{1,64}$"
    },
    "cookie_ref": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "pattern": "^bs_test_[a-z0-9_]{1,48}$"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "evidence_path": {
      "type": "string",
      "minLength": 1
    },
    "installation_id": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "migration_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "20260919_agent_action_receipts_v01.sql",
        "20261001_private_oauth_storage_review.sql",
        "20261023_support_batisenal.sql",
        "20261023_support_batisenal_agent.sql",
        "20261024_batisenal_pilot.sql",
        "20261025_batisenal_v01_policy_fence.sql",
        "20261025_batisenal_v01_synthetic_protocol.sql",
        "20261025_batisenal_v01_case_storage.sql",
        "20261109_batisenal_real_client_binding.sql"
      ],
      "properties": {
        "20260919_agent_action_receipts_v01.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261001_private_oauth_storage_review.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261023_support_batisenal.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261023_support_batisenal_agent.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261024_batisenal_pilot.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261025_batisenal_v01_policy_fence.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261025_batisenal_v01_synthetic_protocol.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261025_batisenal_v01_case_storage.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "20261109_batisenal_real_client_binding.sql": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "pattern": "^bs_[a-z0-9_]{1,48}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "const": "batisenal-synthetic-v01"
    },
    "public_key_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "redirect_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "registration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "release": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "retention_ref": {
      "type": "string",
      "minLength": 1
    },
    "runtime_role": {
      "type": "string",
      "pattern": "^bs_[a-z0-9_]{1,48}$"
    },
    "schema": {
      "type": "string",
      "pattern": "^bs_test_v01_[a-f0-9]{32}$"
    },
    "signer_ref": {
      "type": "string",
      "minLength": 1
    },
    "socket_directory": {
      "type": "string",
      "minLength": 1
    },
    "tournament_id": {
      "type": "string",
      "format": "uuid"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "verifier_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1"
    }
  }
}
