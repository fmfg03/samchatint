[Unit]
Description=Copa Telmex trusted transactional writer without Gate signing material
Requires=ctt-review-workflow.service
After=network.target ctt-review-workflow.service

[Service]
Type=simple
User=ctt-review-writer
Group=ctt-review-transport
SupplementaryGroups=ctt-review-photos
WorkingDirectory=@RUNTIME_ROOT@/samchat
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=@RUNTIME_ROOT@/samchat/src:@RUNTIME_ROOT@/zaubern/services/samchat-registration-gate:@RUNTIME_ROOT@/zaubern/services/evidence-bus:@RUNTIME_ROOT@/vendor
ExecStartPre=@PYTHON@ -m deployment.ctt_protected_review.runtime --config @CONFIG_ROOT@/writer/runtime.json --check
ExecStart=@PYTHON@ -m deployment.ctt_protected_review.runtime --config @CONFIG_ROOT@/writer/runtime.json
RuntimeDirectory=ctt-review-writer
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=no
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=@CONFIG_ROOT@/writer @DATA_ROOT@/writer @DATA_ROOT@/photos
ReadWritePaths=/run/ctt-review-writer
InaccessiblePaths=@CONFIG_ROOT@/workflow @CONFIG_ROOT@/issuer @CONFIG_ROOT@/bus
InaccessiblePaths=@DATA_ROOT@/workflow @DATA_ROOT@/bus
InaccessiblePaths=/etc/zaubern /var/lib/zaubern-evidence-bus
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group

[Install]
WantedBy=multi-user.target
