[Unit]
Description=Actor-bound SamChat report readonly gateway (fmfg)
After=postgresql.service

[Service]
Type=simple
User=agentius-samchat
Group=agentius-executor
WorkingDirectory=/opt/agentius-samchat/readonly-20261009-v1
Environment=PYTHONPATH=/opt/agentius-samchat/readonly-20261009-v1/src
EnvironmentFile=/etc/samchat-readonly/fmfg/admission.env
LoadCredential=database-password:/etc/samchat-readonly/fmfg/database-password
ExecStart=/srv/samchat/venvs/release-598e7a286/bin/python -m samchat.readonly_gateway.service
RuntimeDirectory=agentius-samchat-readonly
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agentius-samchat/readonly-audit/fmfg /run/agentius-samchat-readonly
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1
Restart=no

[Install]
WantedBy=multi-user.target
